# ==============================================================================
# AI SLAT & RIB CONVEYOR INSPECTION - LOCAL ENVIRONMENT (.env)
# Sistem Inspeksi AI Slat & Rib Conveyor
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. INPUT VIDEO & SUMBER KAMERA (VIDEO / CAMERA SOURCES)
# ------------------------------------------------------------------------------
TOP_CAMERA_SOURCE=/home/ai/Downloads/AI Slat RIb/Reverse/Kamera posisi 3 dimmer 2 - Reverse.mp4
SIDE_CAMERA_SOURCE=/home/ai/Downloads/AI Slat RIb/Testing/Opsi Posisi 1 - Bolt & Pin.mp4

# Posisi Kamera Samping ('RIGHT' = CAM-02 RH, 'LEFT' = CAM-03 LH)
SIDE_CAMERA_NAME=RIGHT
SIDE_CAMERA_ID=CAM-02

# ------------------------------------------------------------------------------
# 2. MODEL AI & ENGINE INFERENSI (AI VISION ENGINE)
# ------------------------------------------------------------------------------
# Arsitektur: 'process' (Multi-process isolation multi-core Jetson) atau 'threads'
BENCHMARK_ENGINE=process

# Komputasi Hardware GPU NVIDIA Jetson
INFERENCE_DEVICE=cuda

# Mode deteksi sirip rib: 'HYBRID', 'YOLO_ONLY', atau 'DUAL_POLARITY_ONLY'
RIB_DETECTION_MODE=HYBRID

# Ambang Batas Sensitivitas Deteksi Anomali Retakan PatchCore (Lekukan Braket)
# Nilai 0.8500 mampu mendeteksi retakan halus (incipient crack frame 1545-1550 skor 0.8544) 
# dan retakan parah (>0.900)
PATCHCORE_THRESH=0.8500

# ------------------------------------------------------------------------------
# 3. DURASI & MODE BENCHMARK PENGUJIAN
# ------------------------------------------------------------------------------
BENCHMARK_MODE=dual
BENCHMARK_DURATION=0
RECORD_CSV=jetson_benchmark_fps.csv

# ------------------------------------------------------------------------------
# 4. DATABASE & LOGGING ABNORMALITAS (SQLITE & STORAGE)
# ------------------------------------------------------------------------------
ENABLE_DB_LOGGING=false
SQLITE_DB_PATH=../Database/AI_Slat_Rib_Conveyor.db
CAPTURES_DIR=../Database/captures

# ------------------------------------------------------------------------------
# 5. INTEGRASI NOTIFIKASI & OTOMASI INDUSTRI (NODE-RED / MS TEAMS)
# ------------------------------------------------------------------------------
NODE_RED_ENDPOINT=http://127.0.0.1:1880/ai-inspection
NOTIFICATION_COOLDOWN_SEC=3.0

# ------------------------------------------------------------------------------
# 6. PARAMETER KALIBRASI FISIK & KELAYAKAN KONVEYOR
# ------------------------------------------------------------------------------
SCALE_FACTOR_MM_PER_PX=0.82
TARGET_MIN_FPS=20.0
