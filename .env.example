# ==============================================================================
# AI SLAT & RIB CONVEYOR INSPECTION SYSTEM - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Petunjuk:
# 1. Salin (copy) file ini menjadi '.env' di direktori kerja program:
#    - Windows: copy .env.example .env
#    - Linux/Jetson: cp .env.example .env
# 2. Sesuaikan nilai di dalam file '.env' sesuai spesifikasi perangkat yang digunakan.
#    File '.env' tidak akan di-commit ke Git karena berisi path lokal per-device.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. INPUT VIDEO & SUMBER KAMERA (VIDEO / CAMERA SOURCES)
# ------------------------------------------------------------------------------
# Sumber input untuk CAM-01 (Kamera Atas / Overhead Plat Slat & Bilah Rib)
# Pilihan nilai:
#   a) Path file video lokal:
#      - Windows: C:\Users\Victus\Videos\Kamera_Top.mp4
#      - Jetson/Linux: /home/jetson/videos/top_inspection.mp4 atau Video_Testing/OK Semua.mp4
#   b) Index USB Camera / CSI: 0, 1, 2
#   c) RTSP Stream IP Camera: rtsp://admin:admin123@192.168.1.101:554/stream1
#   d) GStreamer CSI Camera (Jetson): nvarguscamerasrc sensor-id=0 ! video/x-raw(memory:NVMM), width=1920, height=1080 ! nvvidconv ! video/x-raw, format=BGRx ! videoconvert ! appsink
TOP_CAMERA_SOURCE=Video_Testing/OK Semua.mp4

# Sumber input untuk CAM-02 / CAM-03 (Kamera Samping / Baut, Pin & Bracket)
# Contoh Windows: C:\Users\Victus\Pictures\Video & Foto Test Slat Rib\Testing\Opsi Posisi 1 - Bolt & Pin.mp4
# Contoh Jetson: /home/jetson/videos/side_inspection.mp4 atau Video_Testing/Deform Sedikit.mp4 atau 1
SIDE_CAMERA_SOURCE=Video_Testing/Deform Sedikit.mp4

# Posisi Kamera Samping ('RIGHT' = CAM-02 RH, 'LEFT' = CAM-03 LH)
SIDE_CAMERA_NAME=RIGHT
SIDE_CAMERA_ID=CAM-02

# ------------------------------------------------------------------------------
# 2. MODEL AI & ENGINE INFERENSI (AI VISION ENGINE)
# ------------------------------------------------------------------------------
# Engine arsitektur eksekusi runner:
#   - 'threads' : Single process multi-threading (Sangat direkomendasikan untuk Laptop 8GB RAM / 1 GPU)
#   - 'process' : Multi-process terisolasi (Rekomendasi untuk NVIDIA Jetson Orin Nano multi-core)
BENCHMARK_ENGINE=threads

# Device komputasi: 'cuda' (GPU NVIDIA) atau 'cpu'
INFERENCE_DEVICE=cuda

# Mode deteksi sirip rib:
#   - 'HYBRID'             : Gabungan YOLO AI + Deep Profile Computer Vision (Rekomendasi)
#   - 'YOLO_ONLY'          : Hanya model YOLO
#   - 'DUAL_POLARITY_ONLY' : Murni Computer Vision adaptif
RIB_DETECTION_MODE=HYBRID

# Path bobot model AI:
#   - Di Laptop (PyTorch): Dataset Yolo/best_v2.pt dan Dataset Yolo/best_v1.pt
#   - Di Jetson (TensorRT FP16): models/best_v2.engine dan models/best_rib.engine
MODEL_TOP_PATH=Dataset Yolo/best_v2.pt
MODEL_SIDE_PATH=Dataset Yolo/best_v1.pt

# ------------------------------------------------------------------------------
# 3. DURASI & MODE BENCHMARK PENGUJIAN
# ------------------------------------------------------------------------------
# Mode eksekusi GUI/Headless:
#   - 'dual'      : Menampilkan 2 jendela GUI OpenCV berdampingan (Live visual operator)
#   - 'headless'  : Tanpa GUI desktop, murni komputasi inferensi (Cocok untuk Jetson production & Web Dashboard)
#   - 'top-only'  : Hanya kamera atas
#   - 'side-only' : Hanya kamera samping
BENCHMARK_MODE=dual

# Durasi benchmark dalam satuan detik:
#   - 0   : Berjalan terus-menerus (Production mode / tekan 'Q' untuk stop)
#   - 30  : Verifikasi cepat
#   - 300 : Stress test stabilitas & termal Jetson (5 menit)
BENCHMARK_DURATION=0

# Path file CSV untuk mencatat log FPS berkala (kosongkan jika tidak ingin mencatat)
RECORD_CSV=benchmark_results.csv

# ------------------------------------------------------------------------------
# 4. DATABASE & LOGGING ABNORMALITAS (SQLITE & STORAGE)
# ------------------------------------------------------------------------------
# Aktifkan pencatatan insiden NG ke database SQLite dan folder captures: true / false
ENABLE_DB_LOGGING=false

# Path file database SQLite lokal
SQLITE_DB_PATH=../Database/AI_Slat_Rib_Conveyor.db

# Folder penyimpanan bukti visual abnormalitas (raw & annotated bounding box)
CAPTURES_DIR=../Database/captures

# ------------------------------------------------------------------------------
# 5. INTEGRASI NOTIFIKASI & OTOMASI INDUSTRI (NODE-RED / MS TEAMS)
# ------------------------------------------------------------------------------
# Webhook URL Node-RED lokal untuk forward notifikasi ke Adaptive Card MS Teams
NODE_RED_ENDPOINT=http://127.0.0.1:1880/ai-inspection

# Cooldown anti-spam notifikasi (detik per jenis cacat pada benda yang sama)
NOTIFICATION_COOLDOWN_SEC=3.0

# ------------------------------------------------------------------------------
# 6. PARAMETER KALIBRASI FISIK & KELAYAKAN KONVEYOR
# ------------------------------------------------------------------------------
# Ground truth kalibrasi metrologi (Lebar Plat Slat 820mm / 1000px = 0.82 mm/px)
SCALE_FACTOR_MM_PER_PX=0.82

# Target minimum throughput FPS untuk standar kelayakan real-time line conveyor
TARGET_MIN_FPS=20.0
